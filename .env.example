# ============================================================
# EduGenAI - Environment Variables Template
# Copy this file to backend/.env and fill in your keys
# ============================================================

# LLM & AI Keys
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here
HF_API_TOKEN=your_huggingface_token_here

# Video Generation Engine
AI_VIDEO_MODEL=wan-2.1
VIDEO_PROVIDER=pixazo
PIXAZO_API_KEY=your_pixazo_key_here
PIXAZO_MODEL=ltx-video

# Database Configuration (Supabase PostgreSQL / Local)
DATABASE_URL=postgresql+asyncpg://postgres.xxxx:your_password@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# Server Settings
HOST=0.0.0.0
PORT=8000
DEBUG=true

# Directories
OUTPUT_DIR=outputs
AUDIO_DIR=outputs/audio
VIDEO_DIR=outputs/video
SUBTITLE_DIR=outputs/subtitles
